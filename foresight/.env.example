# Copy this file to .env and adjust values for your deployment environment.
# In production (e.g. Docker / AWS EC2 / Render / Railway):
# Set host to 0.0.0.0 and FORESIGHT_API_URL to your public domain.

FORESIGHT_API_HOST=0.0.0.0
FORESIGHT_API_PORT=8000
FORESIGHT_API_URL=http://127.0.0.1:8000
